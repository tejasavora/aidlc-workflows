    "hook_event_name": "SessionStart",
    "source": "startup",
    "session_id": "probe-session-0001"
  },
  "sessionStartResume": {
    "hook_event_name": "SessionStart",
    "source": "resume",
    "session_id": "probe-session-0001"
  },
